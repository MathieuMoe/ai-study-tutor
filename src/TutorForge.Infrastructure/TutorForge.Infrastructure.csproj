<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TutorForge.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gives access to HttpClientFactory, Options, Logging and DI without extra NuGet packages -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TutorForge.Core\TutorForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Offline demo question bank (8 subjects x 4 languages) -->
    <EmbeddedResource Include="Demo\demo-questions.json" LogicalName="TutorForge.Infrastructure.Demo.demo-questions.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TutorForge.Tests" />
  </ItemGroup>

</Project>
