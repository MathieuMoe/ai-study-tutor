@page
@model AboutModel
@{
    ViewData["Title"] = L["Nav_About"];
    const string card = "flex flex-col bg-card border border-card-line shadow-2xs rounded-xl p-4 md:p-5";
}

<div>
    <h1 class="text-2xl font-semibold text-foreground">@L["About_Title"]</h1>
    <p class="mt-1 max-w-3xl text-sm text-muted-foreground-1">@L["About_Subtitle"]</p>
</div>

<div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 sm:gap-6">
    @foreach (var mode in Enum.GetValues<TutorMode>())
    {
        <div class="@card">
            <p class="text-xs uppercase text-muted-foreground-1">@L["Settings_Mode"]</p>
            <h2 class="mt-1 text-lg font-semibold text-foreground">@L[$"Mode_{mode}"]</h2>
            <p class="mt-2 text-sm text-muted-foreground-2">@L[$"About_Mode_{mode}"]</p>
        </div>
    }
</div>

<div class="grid lg:grid-cols-3 gap-4 sm:gap-6">
    @foreach (var (key, icon) in new[]
    {
        ("Privacy", "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"),
        ("Safety", "M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"),
        ("Tech", "m16 18 6-6-6-6M8 6l-6 6 6 6"),
    })
    {
        <div class="@card">
            <span class="size-9 grid place-items-center rounded-lg bg-surface text-primary">
                <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="@icon" /></svg>
            </span>
            <h2 class="mt-3 text-base font-semibold text-foreground">@L[$"About_{key}_Title"]</h2>
            <p class="mt-1 text-sm text-muted-foreground-2">@L[$"About_{key}_Text"]</p>
        </div>
    }
</div>
