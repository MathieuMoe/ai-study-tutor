@{
    var current = ViewContext.RouteData.Values["page"]?.ToString();
    var culture = Localization.CurrentCulture;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var engine = EngineSelection.Current(Context, Engines);
    string EngineLabel(TutorForge.Infrastructure.Engines.TutorEngine e) => e.IsDemo ? L["Engine_Demo"].Value : e.Name;
    var jsStrings = System.Text.Json.JsonSerializer.Serialize(
        L.GetAllStrings().Where(s => s.Name.StartsWith("Js_", StringComparison.Ordinal)).ToDictionary(s => s.Name[3..], s => s.Value));
    string NavClass(string page) =>
        "flex items-center gap-x-3 py-2 px-3 text-sm rounded-lg text-sidebar-nav-foreground hover:bg-sidebar-nav-hover focus:outline-hidden focus:bg-sidebar-nav-focus"
        + (current == page ? " bg-sidebar-nav-active font-medium" : "");
}
<!DOCTYPE html>
<html lang="@culture" class="relative min-h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · MatGPT Tutor</title>
    <link rel="icon" href="~/img/logo.svg" type="image/svg+xml" />
    <script>
        // Apply the saved theme before the first paint (avoids a white flash in dark mode)
        try {
            const t = localStorage.getItem("hs_theme");
            if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches)) document.documentElement.classList.add("dark");
        } catch { }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-background-1 text-foreground antialiased">

    <!-- ========== HEADER ========== -->
    <header class="sticky top-0 inset-x-0 z-48 w-full bg-navbar border-b border-navbar-line lg:ps-65">
        <nav class="px-4 sm:px-6 h-15 flex items-center justify-between gap-x-3">
            <div class="flex items-center gap-x-3">
                <button type="button" class="lg:hidden size-9 inline-flex justify-center items-center rounded-lg border border-layer-line bg-layer text-foreground hover:bg-layer-hover focus:outline-hidden"
                        aria-haspopup="dialog" aria-expanded="false" aria-controls="hs-application-sidebar" aria-label="@L["Nav_OpenMenu"]" data-hs-overlay="#hs-application-sidebar">
                    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="6" y2="6" /><line x1="4" x2="20" y1="12" y2="12" /><line x1="4" x2="20" y1="18" y2="18" /></svg>
                </button>
                <ol class="hidden sm:flex items-center whitespace-nowrap text-sm">
                    <li class="flex items-center text-muted-foreground-1">MatGPT Tutor
                        <svg class="shrink-0 mx-2 size-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6" /></svg>
                    </li>
                    <li class="font-medium text-foreground truncate" aria-current="page">@ViewData["Title"]</li>
                </ol>
            </div>

            <div class="flex items-center gap-x-2">
                <!-- AI engine selector (Preline dropdown): Claude, ChatGPT, Gemini, Ollama or the demo -->
                <div class="hs-dropdown [--placement:bottom-right] relative inline-flex">
                    <button id="engine-menu" type="button" class="hs-dropdown-toggle inline-flex items-center gap-x-1.5 py-1 px-2.5 rounded-full text-xs font-medium border border-layer-line bg-layer text-foreground hover:bg-layer-hover focus:outline-hidden"
                            aria-haspopup="menu" aria-expanded="false" title="@L["Nav_EngineTooltip"]">
                        <span class="size-1.5 rounded-full @(engine.IsDemo ? "bg-amber-500" : "bg-teal-500")"></span>
                        @EngineLabel(engine)
                        <svg class="size-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="hs-dropdown-menu transition-[opacity,margin] duration hs-dropdown-open:opacity-100 opacity-0 hidden min-w-56 z-50 bg-dropdown border border-dropdown-line shadow-md rounded-xl p-1" role="menu" aria-labelledby="engine-menu">
                        <p class="px-3 pt-2 pb-1 text-xs text-muted-foreground-1">@L["Engine_Choose"]</p>
                        @foreach (var e in Engines.All)
                        {
                            <a class="flex items-center justify-between gap-x-3 py-2 px-3 rounded-lg text-sm text-dropdown-item-foreground hover:bg-dropdown-item-hover focus:outline-hidden focus:bg-dropdown-item-focus @(e.Id == engine.Id ? "font-semibold" : "")"
                               href="/engine/@e.Id?returnUrl=@Uri.EscapeDataString(returnUrl)">
                                <span class="flex items-center gap-x-2"><span class="size-1.5 rounded-full @(e.IsDemo ? "bg-amber-500" : "bg-teal-500")"></span>@EngineLabel(e)</span>
                                @if (e.Id == engine.Id)
                                {
                                    <svg class="size-4 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                                }
                            </a>
                        }
                        <p class="px-3 pt-1 pb-2 text-xs text-muted-foreground-1 border-t border-dropdown-divider mt-1">@L["Engine_Hint"]</p>
                    </div>
                </div>
                <!-- Interface language (Preline dropdown) -->
                <div class="hs-dropdown [--placement:bottom-right] relative inline-flex">
                    <button id="lang-menu" type="button" class="hs-dropdown-toggle h-9 px-2.5 inline-flex items-center gap-x-1.5 rounded-full text-sm font-medium text-foreground hover:bg-layer-hover focus:outline-hidden"
                            aria-haspopup="menu" aria-expanded="false" aria-label="@L["Nav_Language"]" title="@L["Nav_Language"]">
                        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
                        <span class="uppercase">@culture</span>
                    </button>
                    <div class="hs-dropdown-menu transition-[opacity,margin] duration hs-dropdown-open:opacity-100 opacity-0 hidden min-w-40 z-50 bg-dropdown border border-dropdown-line shadow-md rounded-xl p-1" role="menu" aria-orientation="vertical" aria-labelledby="lang-menu">
                        @foreach (var (code, name) in Localization.Cultures)
                        {
                            <a class="flex items-center justify-between gap-x-3 py-2 px-3 rounded-lg text-sm text-dropdown-item-foreground hover:bg-dropdown-item-hover focus:outline-hidden focus:bg-dropdown-item-focus @(code == culture ? "font-semibold" : "")"
                               href="/culture/@code?returnUrl=@Uri.EscapeDataString(returnUrl)" lang="@code" hreflang="@code">
                                @name
                                @if (code == culture)
                                {
                                    <svg class="size-4 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                                }
                            </a>
                        }
                    </div>
                </div>
                <button type="button" id="theme-toggle" class="size-9 inline-flex justify-center items-center rounded-full text-foreground hover:bg-layer-hover focus:outline-hidden" aria-label="@L["Nav_ToggleTheme"]">
                    <svg class="size-4 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
                    <svg class="size-4 hidden dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
                </button>
                <a href="https://github.com/MathieuMoe/ai-study-tutor" class="hidden sm:inline-flex items-center gap-x-2 py-2 px-3 text-sm font-medium rounded-lg border border-layer-line bg-layer text-foreground shadow-2xs hover:bg-layer-hover focus:outline-hidden">
                    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z" /></svg>
                    GitHub
                </a>
            </div>
        </nav>
    </header>

    <!-- ========== SIDEBAR ========== -->
    <aside id="hs-application-sidebar" role="dialog" tabindex="-1" aria-label="Sidebar"
           class="hs-overlay [--auto-close:lg] hs-overlay-open:translate-x-0 -translate-x-full transition-all duration-300 transform w-65 h-full hidden fixed inset-y-0 start-0 z-60 bg-sidebar border-e border-sidebar-line lg:block lg:translate-x-0 lg:end-auto lg:bottom-0">
        <div class="relative flex flex-col h-full max-h-full">
            <div class="px-6 h-15 flex items-center">
                <a class="flex items-center gap-x-2.5 text-lg font-semibold text-foreground focus:outline-hidden" href="/" aria-label="MatGPT Tutor">
                    <img src="~/img/logo.svg" alt="" class="size-8 rounded-lg" />
                    <span>MatGPT <span class="text-primary">Tutor</span></span>
                </a>
            </div>

            <nav class="h-full overflow-y-auto px-3 pb-4">
                <ul class="flex flex-col gap-y-1">
                    <li>
                        <a class="@NavClass("/Index")" href="/">
                            <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /></svg>
                            @L["Nav_Tutor"]
                        </a>
                    </li>
                    <li>
                        <a class="@NavClass("/About")" href="/About">
                            <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>
                            @L["Nav_About"]
                        </a>
                    </li>
                </ul>

                <span class="block mt-6 mb-2 px-3 text-xs text-muted-foreground-1">@L["Nav_Resources"]</span>
                <ul class="flex flex-col gap-y-1">
                    <li>
                        <a class="@NavClass("-")" href="https://github.com/MathieuMoe/ai-study-tutor">
                            <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" /></svg>
                            @L["Nav_SourceCode"]
                        </a>
                    </li>
                    <li>
                        <a class="@NavClass("-")" href="https://github.com/MathieuMoe/ai-quiz-generator">
                            <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                            MatGPT Quiz
                        </a>
                    </li>
                    <li>
                        <a class="@NavClass("-")" href="https://docs.claude.com/">
                            <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><path d="M12 17h.01" /></svg>
                            @L["Nav_ClaudeDocs"]
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="p-3 border-t border-sidebar-line">
                <a href="https://www.linkedin.com/in/mathieu-moreau-045b26114/" class="flex items-center gap-x-3 p-2 rounded-lg hover:bg-sidebar-nav-hover focus:outline-hidden">
                    <span class="size-8 grid place-items-center rounded-full bg-surface text-xs font-semibold text-foreground">MM</span>
                    <span class="text-sm leading-tight">
                        <span class="block font-medium text-foreground">Mathieu Moreau</span>
                        <span class="block text-xs text-muted-foreground-1">Full Stack .NET · UI/UX</span>
                    </span>
                </a>
            </div>
        </div>
    </aside>

    <!-- ========== CONTENT ========== -->
    <main class="w-full lg:ps-65 @ViewData["MainClass"]">
        <div class="p-4 sm:p-6 space-y-6 lg:h-full">
            @RenderBody()
        </div>
    </main>

    <script type="application/json" id="i18n">@Html.Raw(jsStrings)</script>
    <script src="~/lib/preline/preline.js" asp-append-version="true"></script>
    <script>
        document.getElementById("theme-toggle")?.addEventListener("click", () => {
            const dark = document.documentElement.classList.toggle("dark");
            try { localStorage.setItem("hs_theme", dark ? "dark" : "light"); } catch { }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
